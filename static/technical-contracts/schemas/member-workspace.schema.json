{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "member-workspace.schema.json",
  "title": "MemberWorkspaceSummary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "simulation_day",
    "member",
    "credit_balance",
    "available_credit_balance",
    "lifetime_contribution",
    "recent_ledger_entries",
    "open_feedbacks",
    "feedback_history",
    "task_counts"
  ],
  "properties": {
    "simulation_day": {
      "$ref": "common.schema.json#/$defs/simulationDay"
    },
    "member": {
      "$ref": "member.schema.json"
    },
    "credit_balance": {
      "type": "integer"
    },
    "available_credit_balance": {
      "type": "integer",
      "description": "当前可主动消费/转账/兑换的积分余额。"
    },
    "lifetime_contribution": {
      "type": "integer",
      "description": "历史累计贡献积分，不因消费或转账减少。"
    },
    "recent_ledger_entries": {
      "type": "array",
      "items": {
        "$ref": "ledger-entry.schema.json"
      }
    },
    "open_feedbacks": {
      "type": "array",
      "items": {
        "$ref": "event-feedback.schema.json"
      }
    },
    "feedback_history": {
      "type": "array",
      "description": "当前成员提交、负责或作为相关方参与的最近事件反馈，包括已结束反馈。",
      "items": {
        "$ref": "event-feedback.schema.json"
      }
    },
    "task_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
