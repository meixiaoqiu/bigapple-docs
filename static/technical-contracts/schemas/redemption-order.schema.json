{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redemption-order.schema.json",
  "title": "RedemptionOrder",
  "description": "A member-initiated redemption order that freezes credits on creation and burns them on fulfillment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order_id",
    "member_no",
    "status",
    "item_type",
    "title",
    "original_amount_rmb",
    "credit_amount",
    "cash_amount_rmb",
    "related_task_id",
    "related_event_id",
    "resource_id",
    "item_snapshot",
    "finance_treatment_ref",
    "reason",
    "metadata",
    "merchant_id",
    "created_by_member_no",
    "reviewed_by_member_no",
    "created_at",
    "updated_at",
    "fulfilled_at",
    "cancelled_at"
  ],
  "properties": {
    "order_id": { "type": "string", "description": "Unique order identifier, e.g. ro-abc123def456." },
    "member_no": { "type": "string", "description": "Member number of the ordering member." },
    "status": { "type": "string", "enum": ["pending", "fulfilled", "cancelled", "disputed", "reversed"] },
    "item_type": { "type": "string", "enum": ["meal", "goods", "resource_use", "room_upgrade", "storage", "parking", "training", "service", "fee_reduction", "other"] },
    "title": { "type": "string", "description": "Short title describing the redemption." },
    "original_amount_rmb": { "type": ["number", "null"], "description": "Original RMB price." },
    "credit_amount": { "type": "integer", "minimum": 1, "description": "Number of credits frozen / burned." },
    "cash_amount_rmb": { "type": ["number", "null"], "description": "Cash portion in RMB." },
    "related_task_id": { "type": "string", "description": "Related Task ID, empty string if none." },
    "related_event_id": { "type": "string", "description": "Related SystemEvent ID." },
    "resource_id": { "type": "string", "description": "关联资源 Resource.resource_id。" },
    "item_snapshot": { "type": "object", "description": "兑换项目结构化快照。" },
    "finance_treatment_ref": { "type": "string", "description": "后续财务处理的外部引用标识。" },
    "reason": { "type": "string", "description": "Human-readable reason." },
    "metadata": { "type": "object", "description": "Extension metadata." },
    "merchant_id": { "type": "string", "description": "关联商户 ID。空字符串表示无商户关联的普通兑换。" },
    "created_by_member_no": { "type": "string", "description": "Creator member number, empty if none." },
    "reviewed_by_member_no": { "type": "string", "description": "Reviewer member number, empty if none." },
    "created_at": { "type": "string", "description": "ISO 8601 timestamp." },
    "updated_at": { "type": "string", "description": "ISO 8601 timestamp." },
    "fulfilled_at": { "type": ["string", "null"], "description": "ISO 8601 or null." },
    "cancelled_at": { "type": ["string", "null"], "description": "ISO 8601 or null." }
  }
}
