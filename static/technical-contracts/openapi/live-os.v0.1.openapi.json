{
  "openapi": "3.1.0",
  "info": {
    "title": "Big Apple Live OS API",
    "version": "0.1.0",
    "description": "Contract draft for the Live OS API used by humans and the Simulation Engine."
  },
  "servers": [
    {
      "url": "https://live-os.example.local/world/{world_id}/api/v0.1",
      "variables": {
        "world_id": {
          "default": "realworld",
          "description": "Target world ID, for example realworld or simulation0001."
        }
      }
    }
  ],
  "paths": {
    "/members/{member_no}": {
      "get": {
        "operationId": "getMember",
        "summary": "Get a member record",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/memberNo"
          }
        ],
        "responses": {
          "200": {
            "description": "Member found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/member.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/notFound"
          }
        }
      }
    },
    "/members/{member_no}/workspace": {
      "get": {
        "operationId": "getMemberWorkspace",
        "summary": "Get the member workspace summary",
        "description": "Returns the member-centered aggregate needed by the member workspace, including ledger entries and event feedback history. This endpoint does not replace ledger, event-feedback, or event APIs; it is a read model for a member-facing product screen.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/memberNo"
          }
        ],
        "responses": {
          "200": {
            "description": "Member workspace summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/member-workspace.schema.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/notFound"
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "List public task projections",
        "description": "Public endpoint for browsing simulation tasks. The response does not include assignee_member_no, submitted_at, reviewed_at, or metadata.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "../schemas/public-task.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{task_id}/claim": {
      "post": {
        "operationId": "claimTask",
        "summary": "Claim an open task",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/taskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/memberActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/task.schema.json"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/conflict"
          }
        }
      }
    },
    "/tasks/{task_id}/submit-labor": {
      "post": {
        "operationId": "submitLabor",
        "summary": "Submit labor for review",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/taskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "member_no",
                  "labor_note"
                ],
                "properties": {
                  "member_no": {
                    "$ref": "../schemas/common.schema.json#/$defs/id"
                  },
                  "labor_note": {
                    "$ref": "../schemas/common.schema.json#/$defs/nonEmptyString"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "$ref": "../schemas/common.schema.json#/$defs/nonEmptyString"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/task.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{task_id}/review": {
      "post": {
        "operationId": "reviewTask",
        "summary": "Review submitted labor",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/taskId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accepted",
                  "reason"
                ],
                "properties": {
                  "accepted": {
                    "type": "boolean"
                  },
                  "reason": {
                    "$ref": "../schemas/common.schema.json#/$defs/nonEmptyString"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task and ledger result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "task",
                    "ledger_entries"
                  ],
                  "properties": {
                    "task": {
                      "$ref": "../schemas/task.schema.json"
                    },
                    "ledger_entries": {
                      "type": "array",
                      "items": {
                        "$ref": "../schemas/ledger-entry.schema.json"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ledger-entries": {
      "get": {
        "operationId": "listLedgerEntries",
        "summary": "List contribution ledger entries",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "member_no",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "../schemas/common.schema.json#/$defs/id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ledger entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "../schemas/ledger-entry.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/resources": {
      "get": {
        "operationId": "listResources",
        "summary": "List resource state",
        "description": "Public endpoint for browsing resource state. The response does not include raw Resource.metadata.",
        "responses": {
          "200": {
            "description": "Resources",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "../schemas/public-resource.schema.json"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/event-feedbacks": {
      "post": {
        "operationId": "createEventFeedback",
        "summary": "Submit real-name feedback about a visible event",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createEventFeedbackRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event feedback created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/event-feedback.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List event stream entries",
        "description": "visibility=public returns public-event projections without involved_member_ids, related_feedback_id, or raw payload. internal/private require an authorized governance principal and return full event records.",
        "parameters": [
          {
            "name": "simulation_day",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "../schemas/common.schema.json#/$defs/simulationDay"
            }
          },
          {
            "name": "visibility",
            "in": "query",
            "required": false,
            "description": "Defaults to public. internal/private require an authorized governance principal.",
            "schema": {
              "type": "string",
              "enum": [
                "public",
                "internal",
                "private"
              ],
              "default": "public"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events. Public visibility returns public-event projections; internal/private visibility returns full event records for authorized governance callers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "../schemas/public-event.schema.json"
                      },
                      {
                        "$ref": "../schemas/event.schema.json"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/capacity-assessments/latest": {
      "get": {
        "operationId": "getLatestCapacityAssessment",
        "summary": "Get the latest capacity assessment",
        "responses": {
          "200": {
            "description": "Latest capacity assessment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/capacity-assessment.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/observer/summary": {
      "get": {
        "operationId": "getObserverSummary",
        "summary": "Get public observer dashboard summary",
        "responses": {
          "200": {
            "description": "Observer dashboard summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "simulation_day",
                    "covenanters",
                    "contributors",
                    "resources",
                    "task_completion_rate",
                    "average_satisfaction",
                    "average_fatigue",
                    "active_feedbacks",
                    "events"
                  ],
                  "properties": {
                    "simulation_day": {
                      "$ref": "../schemas/common.schema.json#/$defs/simulationDay"
                    },
                    "covenanters": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "contributors": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "resources": {
                      "type": "array",
                      "items": {
                        "$ref": "../schemas/public-resource.schema.json"
                      }
                    },
                    "task_completion_rate": {
                      "$ref": "../schemas/common.schema.json#/$defs/score"
                    },
                    "average_satisfaction": {
                      "$ref": "../schemas/common.schema.json#/$defs/score"
                    },
                    "average_fatigue": {
                      "$ref": "../schemas/common.schema.json#/$defs/score"
                    },
                    "active_feedbacks": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "../schemas/public-event.schema.json"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/members/{member_no}/credit-transfers": {
      "post": {
        "operationId": "postCreditTransfer",
        "summary": "Transfer credits from one member to another",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "member_no",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "转出方 member_no（必须与当前登录成员一致）。"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/credit-transfer-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/credit-transfer-response.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — DomainError details in response body",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/error" }
              }
            }
          },
          "403": {
            "description": "Not the transfer initiator"
          }
        }
      }
    },
    "/members/{member_no}/redemption-orders": {
      "get": {
        "operationId": "listRedemptionOrders",
        "summary": "List member redemption orders",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/memberNo" }],
        "responses": {
          "200": {
            "description": "Member redemption orders list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orders": {
                      "type": "array",
                      "items": { "$ref": "../schemas/redemption-order.schema.json" }
                    }
                  }
                }
              }
            }
          },
          "403": { "description": "Not the owner" }
        }
      },
      "post": {
        "operationId": "createRedemptionOrder",
        "summary": "Create a redemption order (freezes credits)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/memberNo" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "../schemas/redemption-order-create-request.schema.json" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/redemption-order.schema.json" }
              }
            }
          },
          "400": { "description": "Domain error" },
          "403": { "description": "Not the owner" }
        }
      }
    },
    "/redemption-orders/{order_id}/cancel": {
      "post": {
        "operationId": "cancelRedemptionOrder",
        "summary": "Cancel a pending/disputed redemption order (unfreezes credits)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/orderId" }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "../schemas/redemption-order-action-request.schema.json" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order cancelled",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/redemption-order.schema.json" }
              }
            }
          },
          "400": { "description": "Order cannot be cancelled" },
          "403": { "description": "Not the owner" }
        }
      }
    },
    "/redemption-orders/{order_id}/issue": {
      "post": {
        "operationId": "reportRedemptionOrderIssue",
        "summary": "Report a fulfillment issue for a pending redemption order",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/orderId" }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "../schemas/redemption-order-action-request.schema.json" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fulfillment issue reported",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/redemption-order.schema.json" }
              }
            }
          },
          "400": { "description": "Issue cannot be reported for this order" },
          "403": { "description": "Not the owner" }
        }
      }
    },
    "/redemption-orders/{order_id}/fulfill": {
      "post": {
        "operationId": "fulfillRedemptionOrder",
        "summary": "Fulfill a redemption order (burns frozen credits)",
        "security": [{ "cookieAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/orderId" }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "../schemas/redemption-order-action-request.schema.json" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order fulfilled",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/redemption-order.schema.json" }
              }
            }
          },
          "400": { "description": "Order cannot be fulfilled" },
          "403": { "description": "Not governance" }
        }
      }
    },
    "/merchant-settlements": {
      "get": {
        "operationId": "listMerchantSettlements",
        "summary": "List merchant settlement records",
        "security": [{ "cookieAuth": [] }],
        "parameters": [
          {
            "name": "merchant_id",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by merchant ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Settlement records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "settlements": {
                      "type": "array",
                      "items": { "$ref": "../schemas/merchant-settlement-record.schema.json" }
                    }
                  }
                }
              }
            }
          },
          "403": { "description": "Not authenticated" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid",
        "description": "Django session cookie for browser-authenticated member and governance actions."
      }
    },
    "parameters": {
      "orderId": {
        "name": "order_id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "memberNo": {
        "name": "member_no",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../schemas/common.schema.json#/$defs/id"
        }
      },
      "taskId": {
        "name": "task_id",
        "in": "path",
        "required": true,
        "schema": {
          "$ref": "../schemas/common.schema.json#/$defs/id"
        }
      }
    },
    "schemas": {
      "memberActionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "member_no"
        ],
        "properties": {
          "member_no": {
            "$ref": "../schemas/common.schema.json#/$defs/id"
          }
        }
      },
      "createEventFeedbackRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "related_event_id",
          "feedback_type",
          "statement"
        ],
        "properties": {
          "related_event_id": {
            "$ref": "../schemas/common.schema.json#/$defs/id"
          },
          "feedback_type": {
            "type": "string",
            "enum": [
              "correction",
              "opinion",
              "complaint",
              "report",
              "review",
              "risk"
            ]
          },
          "subject_member_no": {
            "$ref": "../schemas/common.schema.json#/$defs/id"
          },
          "statement": {
            "$ref": "../schemas/common.schema.json#/$defs/nonEmptyString"
          },
          "requested_outcome": { "type": "string" },
          "evidence_refs": {
            "type": "array",
            "items": {
              "$ref": "../schemas/common.schema.json#/$defs/nonEmptyString"
            }
          },
          "submitter_visibility": {
            "type": "string",
            "enum": ["public", "parties_and_handlers", "handlers_only"]
          },
          "privacy_reason": { "type": "string" },
          "metadata": {
            "$ref": "../schemas/common.schema.json#/$defs/metadata"
          }
        }
      },
      "error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "responses": {
      "notFound": {
        "description": "Record not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/error"
            }
          }
        }
      },
      "conflict": {
        "description": "State conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/error"
            }
          }
        }
      }
    }
  }
}
